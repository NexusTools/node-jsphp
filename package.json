{
  "name": "@nexustools/php",
  "version": "1.0.2",
  "description": "PHP 8.5 runtime, FastCGI PHP-FPM, HTTP server and CLI written in TypeScript for Node.js",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "php": "bin/php.js",
    "php-fpm": "bin/php-fpm.js",
    "php-http-server": "bin/php-http-server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules --max-old-space-size=8192 node_modules/jest/bin/jest.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "php",
    "php8.5",
    "transpiler",
    "cli",
    "fastcgi",
    "php-fpm",
    "php-http-server",
    "wordpress",
    "runtime"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^3.5.3",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "mysql2": "^3.9.0",
    "php-parser": "^3.1.5",
    "php-serialize": "^5.1.3",
    "sharp": "^0.33.2",
    "source-map": "^0.7.4",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/chokidar": "^2.1.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
